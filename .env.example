# Public site URL (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://intematrading.com

# Sanity — create a project at sanity.io/manage, then fill these in.
# Until NEXT_PUBLIC_SANITY_PROJECT_ID is set, the site renders the bundled copy
# in src/content/fallback.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Secret shared with the Sanity webhook that calls /api/revalidate on publish.
SANITY_REVALIDATE_SECRET=

# Contact form delivery — configure at least one for production.
# Email via Resend (resend.com). CONTACT_FROM_EMAIL must be on a domain
# verified in Resend; the default onboarding@resend.dev only reaches the
# Resend account owner.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=INTEMA website <website@intematrading.com>
# Also/instead save inquiries as "Inquiry" documents in Sanity (Editor token).
SANITY_API_WRITE_TOKEN=

# Tawk.to live chat (dashboard → Administration → Chat Widget). Defaults to the
# current widget; set both to override, or set them empty to disable the chat.
NEXT_PUBLIC_TAWK_PROPERTY_ID=6aca1318fc809834cabc847b
NEXT_PUBLIC_TAWK_WIDGET_ID=1k4ill626
